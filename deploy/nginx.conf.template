# Схема исходного запроса. Если перед этим nginx стоит ещё один (
# внешний сервер принимает трафик и проксирует сюда), то TLS терминируется
# там, а сюда запрос приходит по http. Просто взять $scheme нельзя — он всегда
# будет "http", Django сочтёт запрос незащищённым и отправит редирект на https,
# внешний сервер приведёт его обратно, и получится петля. Поэтому доверяем
# заголовку снаружи, а $scheme берём, только когда его нет.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    # Резолвер подставляется при старте контейнера скриптом
    # /docker-entrypoint.d/15-local-resolvers.envsh из /etc/resolv.conf.
    # Зашивать адрес нельзя: 127.0.0.11 — это встроенный DNS docker, а podman
    # держит aardvark-dns на адресе шлюза сети, и с жёстко прописанным
    # 127.0.0.11 nginx под podman отдаёт только 502.
    #
    # Сам резолвер нужен, потому что имя `web` разбирается на каждый запрос:
    # иначе nginx запомнил бы адрес при старте и после пересоздания контейнера
    # продолжал долбиться в старый IP.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $upstream http://web:8000;

    # Статику отдаёт whitenoise внутри приложения: она уже сжата и
    # версионирована манифестом, дублировать раздачу здесь незачем.
    location / {
        # $request_uri обязателен: с переменной в proxy_pass nginx не
        # подставляет путь автоматически.
        proxy_pass $upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_redirect off;
    }

    # Загруженные файлы: фото докладчиков, PDF аннотаций.
    # nosniff обязателен — это пользовательский контент.
    location /media/ {
        alias /srv/media/;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Disposition "inline" always;
        expires 30d;
    }

    location = /healthz {
        proxy_pass $upstream$request_uri;
        proxy_set_header Host $host;
        access_log off;
    }
}
