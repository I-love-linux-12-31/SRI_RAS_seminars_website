[Unit]
Description=Удаление устаревших заявок на семинар (152-ФЗ)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=iki-seminar
Group=iki-seminar
WorkingDirectory=/opt/iki-seminar
EnvironmentFile=/opt/iki-seminar/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod

ExecStart=/usr/local/bin/uv run manage.py purge_registrations

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
