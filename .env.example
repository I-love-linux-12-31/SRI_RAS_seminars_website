# Скопировать в .env и заполнить. В .env НЕ коммитим.
#
# DJANGO_SETTINGS_MODULE здесь намеренно НЕ задаётся: этот файл подключается
# и локально, и в compose через env_file, а env_file перекрывает ENV образа —
# то есть строка «dev» тут запустила бы контейнеры на dev-настройках с DEBUG=True.
# Локально модуль берётся из manage.py (dev), в контейнере — из compose (prod).

SECRET_KEY=change-me-in-production

# Перечислить ВСЕ имена и адреса, по которым сайт открывают, иначе Django
# ответит 400 (DisallowedHost). Для сервера это его домен и внешний IP:
# ALLOWED_HOSTS=seminar.cosmos.ru,10.8.0.23
ALLOWED_HOSTS=localhost,127.0.0.1

# Нужен для отправки форм (регистрация, вход в панель) не с localhost:
# со схемой, через запятую. CSRF_TRUSTED_ORIGINS=https://seminar.cosmos.ru
CSRF_TRUSTED_ORIGINS=

# В compose хост — имя сервиса `db` (порт 5432), с хоста — localhost:5433.
# Порт нестандартный, чтобы не конфликтовать с системным PostgreSQL.
DATABASE_URL=postgres://iki:iki@localhost:5433/iki_seminar
POSTGRES_PORT=5433

# Почта. В dev письма печатаются в консоль.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=seminar@cosmos.ru
SEMINAR_ADMIN_EMAIL=seminar@cosmos.ru

# Только для локальной проверки без TLS. НА ПРОДЕ СТРОКУ УДАЛИТЬ:
# при отсутствии переменной SECURE_SSL_REDIRECT включён по умолчанию.
SECURE_SSL_REDIRECT=False
